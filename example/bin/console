#!/usr/bin/env php
<?php
require_once __DIR__ . '/../../vendor/autoload.php';

use Smerteliko\MicroCli\Application;
use Smerteliko\MicroCli\Config\Config;
use Smerteliko\MicroCli\Config\Loader\PhpLoader;
use Smerteliko\MicroCli\Config\Loader\XmlLoader;
use Smerteliko\MicroCli\DI\Container;
use Smerteliko\MicroCli\Discovery\CommandDiscoverer;
use Smerteliko\MicroCli\EventDispatcher\EventDispatcher;
use Smerteliko\MicroCli\Events\ConsoleCommandEvent;
use Smerteliko\MicroCli\Events\ConsoleTerminateEvent;
use Smerteliko\MicroCli\Macro\MacroManager;

// 1. Initialize DI Container
$container = new Container();

// 2. Setup Configuration
$config = new Config();
$config->addLoader(new PhpLoader());
$config->load(__DIR__ . '/../config/app.php');

// Register config in the container so commands can ask for it!
$container->set(Config::class, $config);

// 3. Initialize Application
$app = new Application($config);
$container->set(Application::class, $app);

// 4. Auto-discover User Commands using Container
$discoverer = new CommandDiscoverer($container);
$commandPaths = $config->get('commands_paths', []);

foreach ($commandPaths as $path => $namespace) {
	$commands = $discoverer->discover($path, $namespace);
	foreach ($commands as $command) {
		$app->add($command);
	}
}

$dispatcher = new EventDispatcher();

$dispatcher->addListener(ConsoleCommandEvent::class, function (ConsoleCommandEvent $event) {
	if ($event->command->getName() === 'greet' && date('w') == 0) {
		$event->output->writeln('<error>Sorry, no greetings on Sundays!</error>');
		$event->disableCommand();
	}
});

$startTime = microtime(true);
$dispatcher->addListener(ConsoleTerminateEvent::class, function (ConsoleTerminateEvent $event) use ($startTime) {
	$duration = round(microtime(true) - $startTime, 4);
	if ($event->output->isVerbose()) {
		$event->output->writeln("<comment>Command finished in {$duration} seconds with exit code {$event->getExitCode()}</comment>");
	}
});

$app->setDispatcher($dispatcher);
$container->set(EventDispatcher::class, $dispatcher);

$dispatcher->addListener(ConsoleCommandEvent::class, function (ConsoleCommandEvent $event) {
	$macroManager = new MacroManager();
	$commandName = $event->command->getName();

	// Мы не должны записывать сами команды управления макросами
	if ($event->command instanceof \Smerteliko\MicroCli\Command\System\MacroCommand) {
		return;
	}

	if ($macroManager->isRecording()) {
		// Идеальный и надежный способ: берем всё из argv, кроме самого имени скрипта (index 0)
		$actualArgs = array_slice($_SERVER['argv'], 1);

		// Экранируем каждый аргумент и склеиваем в строку
		$commandString = implode(' ', array_map('escapeshellarg', $actualArgs));

		$macroManager->addCommand($commandString);

		$event->output->writeln("<comment>[Macro Recording] Added: {$commandString}</comment>");
	}
});
exit($app->run());