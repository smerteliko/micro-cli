{
    "name": "smerteliko/micro-cli",
    "description": "A lightweight, powerful PHP CLI framework with zero dependencies and built-in Web GUI.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "smerteliko",
            "email": "smerteliko@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-libxml": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Smerteliko\\MicroCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\": "example/src/"
        }
    },
    "bin": [
        "bin/micro-cli"
    ],
    "scripts": {
        "init-project": "php bin/micro-cli system:init",
        "gui": "php bin/micro-cli serve:gui",
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}