{
    "name": "smerteliko/micro-cli",
    "description": "A lightweight, object-oriented PHP CLI framework.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "smerteliko",
            "email": "smerteliko@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Smerteliko\\MicroCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\": "example/src/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
